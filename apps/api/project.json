{
  "name": "api",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "tsdown",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "command": "bun --watch src/index.ts",
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PORT": "3000",
          "BETTER_AUTH_URL": "http://localhost:3000",
          "CORS_ORIGIN": "http://localhost:5173"
        }
      }
    },
    "typecheck": {
      "command": "tsgo --noEmit",
      "options": { "cwd": "{projectRoot}" }
    }
  }
}
